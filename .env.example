# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
APP_PASSWORD=
YTDLP_COOKIES=
# Or the cookies.txt file base64-encoded on one line (for hosts with a simple variable editor, e.g. Railway)
YTDLP_COOKIES_B64=
HF_TOKEN=
PEXELS_API_KEY=
# Optional: where projects, caches and the database live (default: ./data)
CLIPFORGE_DATA_DIR=
# Optional: random string used to sign login cookies (auto-generated if empty)
SECRET_KEY=
# Optional: URL of the bgutil proof-of-origin token helper (docker compose sets it for you; on Railway see DEPLOY.md)
POT_PROVIDER_URL=
# Telegram bot for clip notifications and Post / Skip buttons (see DEPLOY.md)
TELEGRAM_BOT_TOKEN=
# YouTube posting: OAuth client from Google Cloud (see DEPLOY.md)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional: the public address of this app (auto-detected from requests when empty)
PUBLIC_URL=
