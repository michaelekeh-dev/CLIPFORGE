# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
APP_PASSWORD=
YTDLP_COOKIES=
# Or the cookies.txt file base64-encoded on one line (for hosts with a simple variable editor, e.g. Railway)
YTDLP_COOKIES_B64=
HF_TOKEN=
PEXELS_API_KEY=
# Optional: where projects, caches and the database live (default: ./data)
CLIPFORGE_DATA_DIR=
# Optional: random string used to sign login cookies (auto-generated if empty)
SECRET_KEY=
